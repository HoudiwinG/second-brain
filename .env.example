# Пример конфигурации окружения.
# Скопируйте в .env и заполните своими значениями. Файл .env в git НЕ добавляется.
# Этап 0: сетевых ключей ещё нет — файл создан для будущих этапов (LLM, интеграции).

# LLM-провайдер (этап 3): openai|anthropic|google
LLM_PROVIDER=openai
# Базовый URL OpenAI-совместимого endpoint (агрегаторы РФ поддерживаются)
LLM_BASE_URL=
# Модель по умолчанию
LLM_MODEL=
# API-ключ вводится пользователем в настройках приложения и хранится
# в secure storage (DPAPI/Keychain/Keystore). В .env НЕ хранить!
# LLM_API_KEY=
